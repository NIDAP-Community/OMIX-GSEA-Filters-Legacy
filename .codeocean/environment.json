{
	"version": 1,
	"base_image": "codeocean/mosuite:v0.3.2",
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"rcran": {
			"packages": [
				{
					"name": "DT"
				},
				{
					"name": "RColorBrewer"
				},
				{
					"name": "htmlwidgets"
				},
				{
					"name": "optparse"
				},
				{
					"name": "patchwork"
				},
				{
					"name": "plotly"
				}
			],
			"use_rcache": true
		}
	}
}