{
	"version": 1,
	"base_image": "codeocean/omix-r-visualization:r4.4.3-v2",
	"post_install": true,
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"apt": {
			"packages": [
				{
					"name": "pandoc",
					"version": "3.1.3+ds-2"
				}
			],
			"install_software_properties_common": true,
			"install_gnupg": true
		},
		"rcran": {
			"packages": [
				{
					"name": "DT",
					"version": "0.34.0"
				}
			],
			"use_rcache": true
		}
	}
}
